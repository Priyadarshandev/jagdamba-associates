# ============================================================
# Jagdamba Associates — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials
# ============================================================

# ---- Backend API ----
PORT=3001
NODE_ENV=development

# MongoDB connection string (required for form submissions)
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Example: mongodb+srv://username:password@cluster.mongodb.net/jagdamba?retryWrites=true&w=majority
MONGODB_URI=

# Allowed CORS origin (set to your frontend URL in production)
# Development: http://localhost:5173
# Production: https://jagdambaassociates.in
ALLOWED_ORIGIN=http://localhost:5173
